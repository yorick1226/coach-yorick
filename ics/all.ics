UID:2026-11-19-b@coach
DTSTAMP:20261122T195957Z
LAST-MODIFIED:20261122T195957Z
SEQUENCE:922959
DTSTART;VALUE=DATE:20261119
DTEND;VALUE=DATE:20261120
SUMMARY:Kracht: Upper B
DESCRIPTION:Doel: rug breed + schouders sterk\, borst 2e prikkel. Kies per
  blok zelf de oefening\; houd reps\, RIR en rust aan.
TRANSP:TRANSPARENT
END:VEVENT
